#!/bin/bash

ENABLE_LOG=$(snapctl get graphs-gend.enable-log)
ENABLE_LOG=${ENABLE_LOG:-0}

if [ "$ENABLE_LOG" != "0" ]; then
	set -x
fi

# wait until all required interfaces are connected
PLUGS="process-control"
while true; do
	WAIT=0
	for plug in $PLUGS; do
		snapctl is-connected "$plug" || WAIT=1
		if [ "$WAIT" -eq 1 ]; then
			sleep 10
			break
		fi
	done
	if [ "$WAIT" -eq 0 ]; then
		break
	fi
done

# delay for dump1090 and collectd
sleep 3

export XDG_DATA_HOME=$SNAP/usr/share
export FONTCONFIG_PATH=$SNAP/etc/fonts

## crontab commands
#*/5 * * * * root bash $PORTALBUILDDIRECTORY/graphs/make-collectd-graphs.sh 1h >/dev/null 2>&1
#*/10 * * * * root bash $PORTALBUILDDIRECTORY/graphs/make-collectd-graphs.sh 6h >/dev/null 2>&1
#2,12,22,32,42,52 * * * * root bash $PORTALBUILDDIRECTORY/graphs/make-collectd-graphs.sh 24h >/dev/null 2>&1
#4,24,44 * * * * root bash $PORTALBUILDDIRECTORY/graphs/make-collectd-graphs.sh 7d >/dev/null 2>&1
#6 * * *	* root bash $PORTALBUILDDIRECTORY/graphs/make-collectd-graphs.sh 30d >/dev/null 2>&1
#8 */12 * * * root bash $PORTALBUILDDIRECTORY/graphs/make-collectd-graphs.sh 365d >/dev/null 2>&1

TIMEOUT_1h=0
TIMEOUT_6h=0
TIMEOUT_12h=0
TIMEOUT_24h=0
TIMEOUT_7d=0
TIMEOUT_30d=0
TIMEOUT_90d=0
TIMEOUT_180d=0
TIMEOUT_365d=0
TIMEOUT_BACKUP=0

PERIOD_1h=300
PERIOD_6h=600
PERIOD_12h=600
PERIOD_24h=900
PERIOD_7d=1800
PERIOD_30d=3600
PERIOD_90d=7200
PERIOD_180d=14400
PERIOD_365d=43200

OFFSET_12h=120
OFFSET_24h=120
OFFSET_7d=240
OFFSET_30d=360
OFFSET_90d=360
OFFSET_180d=480
OFFSET_365d=480

PERIOD_BACKUP=$(snapctl get collectd.rrd-backup-period)
PERIOD_BACKUP=${PERIOD_BACKUP:-0}

# create output directory which is defined in make-collectd-graphs.sh
mkdir -p /tmp/graphs

# draw all graphs of a period ($1), $2 is the pause between the graphs
gen_graphs()
{
	if [ "$ENABLE_LOG" != "0" ]; then
		echo "[$(date +"%F %T")] run cmd, arg=$*"
	fi
	# without a 978MHz receiver, skip the UAT graphs (the same check as
	# bin/collectd and bin/lighttpd)
	if [ -z "$(snapctl get receiver.dump978.index)" ] && [ -z "$(snapctl get receiver.dump978.serial)" ]; then
		export SKIP_UAT=1
	else
		unset SKIP_UAT
	fi
	nice -n 5 "$SNAP/usr/share/graphs1090/graphs1090.sh" "$1" "$2" >/dev/null 2>&1
}

# graphs.always-generate=1: draw the graphs of every period on schedule;
# otherwise draw only the periods which the graphs page asked for recently
ALWAYS_GENERATE=$(snapctl get graphs.always-generate)
WANTED_DIR=/tmp/graphs-wanted	# written by bin/graphs-wanted-cgi
GRAPHS_DIR=/tmp/graphs1090	# DOCUMENTROOT of graphs1090.sh
IDLE_TIMEOUT=300

# wanted PERIOD: somebody viewed the graphs of PERIOD in the last 5 minutes
wanted()
{
	[ -f "$WANTED_DIR/$1" ] && [ $((now - $(stat -c %Y "$WANTED_DIR/$1"))) -lt "$IDLE_TIMEOUT" ]
}

# stale PERIOD INTERVAL: the graphs of PERIOD are missing or older than INTERVAL
stale()
{
	img="$GRAPHS_DIR/dump1090-localhost-aircraft-$1.png"
	[ ! -f "$img" ] || [ $((now - $(stat -c %Y "$img"))) -ge "$2" ]
}

# check_period PERIOD: draw the graphs of PERIOD if needed
check_period()
{
	eval "timeout=\$TIMEOUT_$1 interval=\$PERIOD_$1"
	due=0
	if [ "$now" -ge "$timeout" ]; then
		due=1
		eval "TIMEOUT_$1=$((timeout + interval))"
	fi

	if [ "$ALWAYS_GENERATE" = "1" ]; then
		[ "$due" -eq 1 ] && gen_graphs "$1" 0.7 &
		return 0
	fi

	wanted "$1" || return 0
	# while somebody views the graphs, redraw them at the same intervals as
	# the schedule; draw at once without pauses if they are missing or much
	# older (first view after a while)
	if stale "$1" $((interval * 2)); then
		gen_graphs "$1" 0 &
	elif stale "$1" "$interval"; then
		gen_graphs "$1" 0.7 &
	fi
}

init_timeouts()
{
	now=$(date +"%s")

	mod=$((now%PERIOD_1h))
	TIMEOUT_1h=$((now-mod))
	mod=$((now%PERIOD_6h))
	TIMEOUT_6h=$((now-mod))
	mod=$((now%PERIOD_12h))
	TIMEOUT_12h=$((now-mod+OFFSET_12h))
	mod=$((now%PERIOD_24h))
	TIMEOUT_24h=$((now-mod+OFFSET_24h))
	mod=$((now%PERIOD_7d))
	TIMEOUT_7d=$((now-mod+OFFSET_7d))
	mod=$((now%PERIOD_30d))
	TIMEOUT_30d=$((now-mod+OFFSET_30d))
	mod=$((now%PERIOD_90d))
	TIMEOUT_90d=$((now-mod+OFFSET_90d))
	mod=$((now%PERIOD_180d))
	TIMEOUT_180d=$((now-mod+OFFSET_180d))
	mod=$((now%PERIOD_365d))
	TIMEOUT_365d=$((now-mod+OFFSET_365d))
	if [ "$PERIOD_BACKUP" -ne 0 ]; then
		# backup is not necessary at the beginning
		TIMEOUT_BACKUP=$((now+PERIOD_BACKUP))
	fi
}

init_timeouts

# on demand, check more often to draw soon after the page asks for graphs
LOOP_INTERVAL=60
[ "$ALWAYS_GENERATE" = "1" ] || LOOP_INTERVAL=10

while true; do
	now=$(date +"%s")

	for period in 1h 6h 12h 24h 7d 30d 90d 180d 365d; do
		check_period "$period"
	done

	## Backup work
	if [ "$PERIOD_BACKUP" -ne 0 ] && [ "$now" -ge "$TIMEOUT_BACKUP" ]; then
		rrd-op backup &
		TIMEOUT_BACKUP=$((TIMEOUT_BACKUP+PERIOD_BACKUP))
	fi

	sleep "$LOOP_INTERVAL"
done

